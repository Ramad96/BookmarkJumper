{
  "manifest_version": 3,
  "name": "Bookmark Jumper",
  "version": "1.0.5",
  "description": "Find a bookmark, explore its folder, and jump there in your current tab.",
  "minimum_chrome_version": "110",
  "permissions": ["bookmarks"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/toolbar-16.png",
      "32": "icons/toolbar-32.png"
    },
    "default_title": "Open Bookmark Jumper",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+H" }
    }
  }
}
